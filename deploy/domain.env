# 域名与服务器地址的唯一配置源。
# 换域名时只改这个文件，然后执行：bash deploy/apply-domain.sh
# 之后提交 Git，在服务器执行 git pull && bash deploy/install-nginx-ubuntu.sh

# 主域名（不带 www，不带协议）。未购买域名时保持 sslip.io 临时地址。
PRIMARY_DOMAIN="yiyeying.com"

# 服务器公网 IP。用于保留 IP 直接访问与 Nginx server_name。
SERVER_IP="134.195.211.122"

# 备用域名，逗号分隔，留空则只保留主域名与 www 前缀（www 前缀自动生成，无需填写）。
EXTRA_DOMAINS=""

# 对外展示使用的协议。
# 当前 HTTPS 由 Cloudflare 代理提供（回源 80 端口），源站无需配置证书。
PUBLIC_SCHEME="https"
SSL_CERT_PATH=""
SSL_KEY_PATH=""
